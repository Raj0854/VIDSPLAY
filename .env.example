# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Database URL
# Local SQLite default:
DATABASE_URL=sqlite:///vidsplay.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/vidsplay

# Upload Settings
MAX_CONTENT_LENGTH=524288000  # 500 MB in bytes
UPLOAD_FOLDER=static/uploads

# Admin Credentials (change these values to update your admin login)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vidsplay.com
ADMIN_PASSWORD=admin123

# Server Port
PORT=5000
HOST=127.0.0.1
